# ============================================================
# qBot - Telegram Bot for qBittorrent & MeTube Configuration
# Copy this file to .env and adjust your settings:
#   cp .env.example .env
# ============================================================

# ------------------------------------------------------------
# Telegram Settings (Required)
# ------------------------------------------------------------
# Telegram Bot Token from @BotFather
BOT_TOKEN=123456789:ABCdefGhIJKlmNoPQRsTUVwxyZ

# Comma-separated list of Telegram User IDs allowed to interact with the bot
# Use @userinfobot on Telegram to find your user ID
ALLOWED_USER_IDS=12345678

# ------------------------------------------------------------
# Local Telegram Bot API Server (Optional - Enables 2 GB Uploads)
# ------------------------------------------------------------
# Leave TELEGRAM_API_URL empty to use Telegram's standard cloud API (50 MB upload limit).
# If using a local Telegram Bot API server (e.g. via docker compose --profile local-api up),
# set this to your local server URL (e.g. http://127.0.0.1:8082), which enables up to 2,000 MB (2 GB) uploads!
TELEGRAM_API_URL=
# TELEGRAM_MAX_UPLOAD_MB=2000

# Get these from https://my.telegram.org under "API development tools":
TELEGRAM_API_ID=
TELEGRAM_API_HASH=
# Uncomment to automatically start the telegram-bot-api service with docker compose:
# COMPOSE_PROFILES=local-api

# ------------------------------------------------------------
# qBittorrent Settings
# ------------------------------------------------------------
QB_URL=http://127.0.0.1:8080
QB_USER=admin
QB_PASS=adminadmin

# Action on torrent completion:
# 'stop' or 'pause' => Pauses the torrent (leaves it in qBittorrent list)
# 'remove'          => Removes torrent from qBittorrent but keeps downloaded files
# 'remove_data'     => Removes torrent AND deletes downloaded files from disk
ACTION_ON_COMPLETE=stop

# ------------------------------------------------------------
# Disks & Categories
# ------------------------------------------------------------
# Comma-separated list of disk mount points or storage directories
DISKS=/mnt/ftp,/mnt/ftp2
DEFAULT_DISK_IDX=0

# Categories / subdirectories for downloads
# Format: key:Label,key2:Label2 (or JSON format {"tv":"📺 Series"})
CATEGORIES=tv:📺 Series,movies:🎬 Movies,download-pc:📁 Other,Music:🎵 Music,photo:🖼 Photo,cartoni:🧸 Cartoni,vidcontent:🎬 Videos

# ------------------------------------------------------------
# MeTube Settings (Video & Audio URL Downloads)
# ------------------------------------------------------------
# Set to true to enable MeTube integration (defaults to true if METUBE_URL is set)
METUBE_ENABLED=true
METUBE_URL=http://127.0.0.1:8081
# Public URL for downloading files outside local network (e.g. reverse proxy or domain)
METUBE_PUBLIC_URL=
METUBE_DEFAULT_QUALITY=best

# Comma-separated list of allowed video domains (leave empty to allow all HTTP/HTTPS links)
METUBE_DOMAINS=youtube.com,youtu.be,www.youtube.com,m.youtube.com,vimeo.com,twitter.com,x.com,instagram.com,tiktok.com,www.tiktok.com,reddit.com,twitch.tv,dailymotion.com

# ------------------------------------------------------------
# Jellyfin Settings (Optional Library Refresh)
# ------------------------------------------------------------
JELLYFIN_ENABLED=false
JELLYFIN_URL=http://127.0.0.1:8096
JELLYFIN_API_KEY=

# ------------------------------------------------------------
# Bot Runtime, State & Timings (Optional)
# ------------------------------------------------------------
STATE_FILE=/app/data/bot_state.json
LOG_FILE=
LOG_LEVEL=info

# Timings in seconds
POLL_TIMEOUT=10
CHECK_INTERVAL=30
STATE_SAVE_INTERVAL=300
NOTIFICATION_CLEANUP_TIME=120

# Status display options
STATUS_SHOW_LIMIT=10
STATUS_FILTER=all
